{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ts-lint": "tsc --noEmit --incremental",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:auth-radar": "node --env-file=.env scripts/migrate-auth-radar-data.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:engagement:db": "node --import tsx --test tests/*.integration.ts",
    "test:engagement:browser": "node tests/article-engagement.browser.mjs",
    "db:migrate:replies": "node --env-file=.env scripts/migrate-redis-replies.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.2",
    "@sanity/image-url": "^2.0.3",
    "@upstash/qstash": "^2.9.0",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "firebase": "12.4.0",
    "keycloak-js": "^26.2.4",
    "next": "^16.4.3",
    "next-sanity": "^12.0.14",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "resend": "^6.9.1",
    "sanity": "^5.7.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "an-array-of-english-words": "^2.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
